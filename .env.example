# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/virtual_boyfriend

# 会话密钥（生产环境请使用随机字符串）
SESSION_SECRET=your-secret-key-change-in-production

# 管理员初始密码（可选，不设置则自动生成随机密码）
ADMIN_PASSWORD=your-admin-password-here

# GPT-Image-1.5 API 配置（可选）
GPT_IMAGE_API_KEY=your-gpt-image-api-key-here
GPT_IMAGE_API_BASE=https://api.evolink.ai/v1
GPT_IMAGE_MODEL=gpt-image-1.5

# 火山引擎 Ark API 配置（备用，可选）
VOLCENGINE_API_KEY=your_api_key_here
VOLCENGINE_API_BASE=https://ark.cn-beijing.volces.com/api/v3

# Coze API（作为回退，可选）
COZE_API_KEY=
COZE_API_BASE=
