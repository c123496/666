# ================================
# 环境变量配置模板（脱敏版本）
# ================================
# 说明：
# 1. 本文件只包含变量名和示例占位符，可安全提交到 Git
# 2. 真实配置请在 .env.local 中设置
# 3. .env.local 不会被 Git 跟踪，请勿将真实密钥提交到代码库
# ================================

# --------------------
# 数据库配置
# --------------------
DATABASE_URL=postgresql://user:password@localhost:5432/virtual_boyfriend
DIRECT_URL=postgresql://user:password@localhost:5432/virtual_boyfriend

# 会话密钥
SESSION_SECRET=your-secret-key-change-in-production

# 应用 URL（用于邮件中的链接）
# 本地开发：http://localhost:5000
# 生产环境：https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:5000

# --------------------
# 管理员初始密码（可选）
# --------------------
ADMIN_PASSWORD=your-admin-password-here

# --------------------
# EvoLink API 配置（文本模型）
# --------------------
EVOLINK_API_KEY=your_evolink_api_key_here
EVOLINK_BASE_URL=https://api.evolink.ai
TEXT_MODEL=gemini-2.5-flash-lite

# --------------------
# 火山方舟 Seedream 图片生成 API 配置
# --------------------
VOLCENGINE_ARK_API_KEY=ark-your-api-key-here
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_IMAGE_MODEL=doubao-seedream-5-0-260128

# --------------------
# Coze API（作为回退，可选）
# --------------------
COZE_API_KEY=
COZE_API_BASE=

# --------------------
# Turnstile 人机验证配置
# --------------------
# 获取方式：前往 https://dash.cloudflare.com/ 创建 Turnstile 应用

# 前端公开 key（可暴露在浏览器中）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# 后端密钥（仅服务端使用，不要泄露）
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# 开发环境说明：
# - localhost 环境会自动使用 Cloudflare 官方测试 key
# - 无需在本地配置这些变量即可测试
# - 生产部署时才需要配置正式 key

# 生产部署说明：
# - Vercel / 服务器环境变量中添加以上两个配置
# - 修改环境变量后需要重新部署
# - 在 Cloudflare 后台添加生产域名到 Hostname Management

# --------------------
# Cloudflare R2 对象存储配置
# --------------------
# 获取方式：前往 Cloudflare Dashboard > R2 > 创建 R2 API Token

# R2 账户 ID（用于拼接 endpoint）
R2_ACCOUNT_ID=1d00b2439f473aa7bdae87b2a17eecef

# R2 API 访问凭证
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# R2 存储桶配置
R2_BUCKET_NAME=paperboyfriendimage
R2_PUBLIC_URL=https://pub-60aa16dfaac348fe95b104aa89084566.r2.dev

# R2 Endpoint（可选，如果不配置则自动拼接为 https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com）
R2_ENDPOINT=https://1d00b2439f473aa7bdae87b2a17eecef.r2.cloudflarestorage.com

# 说明：
# - ACCOUNT_ID：Cloudflare 账户 ID，在 R2 Dashboard 右侧可以找到
# - ACCESS_KEY_ID 和 SECRET_ACCESS_KEY：R2 API Token 认证信息
# - BUCKET_NAME：存储桶名称（必须设置为 paperboyfriendimage）
# - PUBLIC_URL：存储桶的公开访问 URL（自定义域名或 R2 public URL）
# - ENDPOINT：R2 存储端点 URL（可选，默认会根据 ACCOUNT_ID 自动生成）

# --------------------
# Resend 邮件服务配置
# --------------------
# 获取方式：前往 https://resend.com/api-keys 创建 API Key

RESEND_API_KEY=your_resend_api_key_here

# 邮件发件人配置（可选）
# RESend_FROM_EMAIL: 发件人邮箱地址
# - 试用模式：onboarding@resend.dev（只能发给注册邮箱）
# - 正式模式：noreply@yourdomain.com（需要验证域名）
RESEND_FROM_EMAIL=onboarding@resend.dev

# RESend_FROM_NAME: 发件人名称
RESEND_FROM_NAME=纸片人男友

# 开发环境测试收件邮箱（重要！）
# 说明：
# - onboarding@resend.dev 只能发给你的 Resend 注册邮箱
# - 开发环境下，用户注册填写的邮箱会被替换为这个测试邮箱
# - 生产环境或验证域名后，此变量会被忽略
# - 请填写你注册 Resend 时使用的邮箱
RESEND_TEST_TO_EMAIL=your_resend_account_email@example.com

# 测试接口开关（仅用于开发调试）
# 说明：
# - 设置为 true 时，启用 /api/test-welcome-email 测试接口
# - 生产环境建议设置为 false 或不设置
# ENABLE_TEST_EMAIL=true

# Cron 任务密钥（定时任务安全验证）
# 说明：
# - 用于保护 Vercel Cron 接口，防止未授权访问
# - 生成方法：openssl rand -base64 32
# - 生产环境必须设置
CRON_SECRET=your_random_secret_key_here

# 说明：
# - RESEND_API_KEY：Resend 服务的 API 密钥，用于发送邮件
# - RESEND_FROM_EMAIL：发件人邮箱地址（默认使用 Resend 试用域名）
# - RESEND_FROM_NAME：发件人显示名称（默认：纸片人男友）
# - 试用模式限制：只能发给 Resend 注册时的邮箱
# - 正式模式：需要在 Resend Dashboard 验证你的域名

