# ================================
# 环境变量配置模板（脱敏版本）
# ================================
# 说明：
# 1. 本文件只包含变量名和示例占位符，可安全提交到 Git
# 2. 真实配置请在 .env.local 中设置
# 3. .env.local 不会被 Git 跟踪，请勿将真实密钥提交到代码库
# ================================

# --------------------
# 数据库配置
# --------------------
DATABASE_URL=postgresql://user:password@localhost:5432/virtual_boyfriend
DIRECT_URL=postgresql://user:password@localhost:5432/virtual_boyfriend

# --------------------
# 会话密钥
# --------------------
SESSION_SECRET=your-secret-key-change-in-production

# --------------------
# 管理员初始密码（可选）
# --------------------
ADMIN_PASSWORD=your-admin-password-here

# --------------------
# EvoLink API 配置（文本模型）
# --------------------
EVOLINK_API_KEY=your_evolink_api_key_here
EVOLINK_BASE_URL=https://api.evolink.ai
TEXT_MODEL=gemini-2.5-flash-lite

# --------------------
# 火山方舟 Seedream 图片生成 API 配置
# --------------------
VOLCENGINE_ARK_API_KEY=ark-your-api-key-here
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_IMAGE_MODEL=doubao-seedream-5-0-260128

# --------------------
# Coze API（作为回退，可选）
# --------------------
COZE_API_KEY=
COZE_API_BASE=

# --------------------
# Turnstile 人机验证配置
# --------------------
# 获取方式：前往 https://dash.cloudflare.com/ 创建 Turnstile 应用

# 前端公开 key（可暴露在浏览器中）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# 后端密钥（仅服务端使用，不要泄露）
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# 开发环境说明：
# - localhost 环境会自动使用 Cloudflare 官方测试 key
# - 无需在本地配置这些变量即可测试
# - 生产部署时才需要配置正式 key

# 生产部署说明：
# - Vercel / 服务器环境变量中添加以上两个配置
# - 修改环境变量后需要重新部署
# - 在 Cloudflare 后台添加生产域名到 Hostname Management

# --------------------
# Cloudflare R2 对象存储配置
# --------------------
# 获取方式：前往 Cloudflare Dashboard > R2 > 创建 R2 API Token

# R2 API 访问凭证
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# R2 存储桶配置
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxx.r2.dev

# 说明：
# - ACCESS_KEY_ID 和 SECRET_ACCESS_KEY：R2 API Token 认证信息
# - ENDPOINT：R2 存储端点 URL
# - BUCKET_NAME：存储桶名称
# - PUBLIC_URL：存储桶的公开访问 URL

