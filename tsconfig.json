{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "drizzle-orm": [
        "./node_modules/.pnpm/drizzle-orm@0.45.1_@types+pg@8.16.0_pg@8.17.2/node_modules/drizzle-orm"
      ],
      "drizzle-orm/*": [
        "./node_modules/.pnpm/drizzle-orm@0.45.1_@types+pg@8.16.0_pg@8.17.2/node_modules/drizzle-orm/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "local-next/types/**/*.ts",
    "local-next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
